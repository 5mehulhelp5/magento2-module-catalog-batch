<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="kingletas" translate="label" sortOrder="400">
            <label>Kingletas</label>
        </tab>
        <section id="kingletas_catalog_batch" translate="label" type="text" sortOrder="20" showInDefault="1"
                 showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Catalog Batch</label>
            <tab>kingletas</tab>
            <resource>Kingletas_CatalogBatch::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1"
                   showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1"
                       showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Batch Configurable Attribute Queries</label>
                    <comment>Asks for every configurable product's attribute rows, labels and options once per page instead of once per product. Reads the same tables Magento reads and stores nothing.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="batch_size" translate="label comment" type="text" sortOrder="20" showInDefault="1"
                       canRestore="1">
                    <label>Products Per Query</label>
                    <comment>How many configurable products one query may cover. A page with more is covered by several.</comment>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
